# Hoshiyar Shield — example environment file.
# The core app needs NO environment variables: classification runs on-device.
# Copy to .env only if you enable an optional backend (see docs/deployment.md).

# Optional community-report backend (not required for the MVP / demo)
# EXPO_PUBLIC_REPORTS_API_URL=https://your-reports-api.example

# Never put service-role keys or secrets in EXPO_PUBLIC_* variables:
# anything prefixed EXPO_PUBLIC_ is compiled into the APK and readable by anyone.
